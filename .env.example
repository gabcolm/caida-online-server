# Caída Online — variables de entorno
# Copia este archivo a .env y rellena tus valores.
# NO subas .env al repositorio.

# --- Servidor ---
PORT=3000
# PostgreSQL: en Render usa la cadena de Neon; en local, caida_online.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/caida_online
# DATABASE_URL_TEST=postgresql://usuario:clave@localhost:5432/caida_online_test
TURN_MS=30000
RECONNECT_MS=45000
CORS_ORIGIN=*
# TLS_CERT=/etc/caida/cert.pem
# TLS_KEY=/etc/caida/key.pem
# TRUST_PROXY=1

# --- Rate limiting ---
# REDIS_URL=redis://127.0.0.1:6379
API_RATE_MAX=300
AUTH_RATE_MAX=30
LOGIN_FAIL_MAX=8
WS_RATE_MAX=60
WS_RATE_WINDOW_MS=10000

# --- Desarrollo / verificación ---
# En producción: NODE_ENV=production y DEV_CODES=0
NODE_ENV=development
DEV_CODES=0
REQUIRE_EMAIL=0
REQUIRE_VERIFIED=0
VERIFY_AFTER_MATCHES=0
# Duración de los códigos (mínimo 15 minutos)
RECOVERY_CODE_TTL_MIN=15
VERIFY_CODE_TTL_MIN=15
TOTP_ISSUER="Caída Online"

# --- SMTP (elige SMTP_URL o SMTP_HOST/PORT/USER/PASS) ---
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=0
#   SMTP_USER=tu@gmail.com
#   SMTP_PASS="contraseña de aplicación de 16 caracteres sin espacios"
#   SMTP_FROM="Caída Online <tu@gmail.com>"   # debe ser la misma cuenta
# SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.com:465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Caída Online <no-reply@tudominio.com>"
SMTP_REPLY_TO=
# 0 = automático (STARTTLS en Gmail 587)
SMTP_REQUIRE_TLS=0
# 1 = log detallado del protocolo SMTP (puede incluir datos sensibles)
SMTP_DEBUG=0

# --- Correo por API HTTP (recomendado en Render Free) ---
# Render Free bloquea los puertos SMTP 25/465/587. Con Resend o Brevo el
# envío sale por HTTPS (puerto 443) y funciona en el plan gratuito.
# MAIL_PROVIDER=resend        # resend | brevo | smtp (vacío = autodetecta)
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAIL_FROM="Caída Online <no-reply@tudominio.com>"
# MAIL_HTTP_TIMEOUT_MS=15000

# --- DKIM ---
DKIM_DOMAIN=
DKIM_SELECTOR=caida
# Ruta al PEM o clave PEM completa:
DKIM_PRIVATE_KEY=

# --- Auditoría y alertas ---
ADMIN_TOKEN=
AUDIT_RETENTION_DAYS=90
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
ALERT_FAIL_THRESHOLD=3
ALERT_THROTTLE_MS=60000
